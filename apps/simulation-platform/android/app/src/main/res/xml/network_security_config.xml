<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext for all domains needed by the app -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- Specific domains used by the app -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">cartocdn.com</domain>
        <domain includeSubdomains="true">tile.openstreetmap.org</domain>
        <domain includeSubdomains="true">overpass-api.de</domain>
        <domain includeSubdomains="true">unpkg.com</domain>
        <domain includeSubdomains="true">basemaps.cartocdn.com</domain>
    </domain-config>
</network-security-config>
